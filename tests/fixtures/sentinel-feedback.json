  {"name": "flag-record-idempotent-and-ack", "kind": "edge", "added": true,
   "input": {"action": "scenario", "audit": "none", "ops": [
     {"op": "record_flag", "user": "u1", "source": "sentinel", "count": 4, "as": "f1"},
     {"op": "record_flag", "user": "u1", "source": "sentinel", "count": 5, "as": "f2", "same_as": "f1"},
     {"op": "list_flags", "user": "u1", "expect_len": 1, "expect_status": ["flagged"]},
     {"op": "list_flags", "user": "u1", "status": "acknowledged", "expect_len": 0},
     {"op": "record_flag", "user": "u2", "source": "sentinel", "count": 4, "as": "g1", "differs_from": "f1"},
     {"op": "ack", "flag": "f1", "user": "u2", "raises": "InsightNotFound"},
     {"op": "ack", "flag": "nope", "user": "u1", "raises": "InsightNotFound"},
     {"op": "list_flags", "user": "u1", "status": "flagged", "expect_len": 1},
     {"op": "ack", "flag": "f1", "user": "u1"},
     {"op": "list_flags", "user": "u1", "status": "acknowledged", "expect_len": 1, "expect_status": ["acknowledged"]},
     {"op": "list_flags", "user": "u1", "status": "flagged", "expect_len": 0},
     {"op": "list_flags", "user": "u2", "expect_len": 1}
   ]}, "expected": "ok"},

  {"name": "handoff-open-idempotent-system-message", "kind": "duplicate", "added": true,
   "input": {"action": "scenario", "audit": "none", "ops": [
     {"op": "h_open", "id": "ins-1", "user": "u1", "reason": "bad insight", "as": "t1"},
     {"op": "h_open", "id": "ins-1", "user": "u1", "as": "t2", "same_as": "t1"},
     {"op": "h_open", "id": "ins-2", "user": "u1", "as": "t3", "differs_from": "t1"},
     {"op": "h_get", "thread": "t1", "user": "u1", "role": "user", "expect": {"thread_id": "@label:t1", "insight_id": "ins-1", "user_id": "u1", "reason": "bad insight", "created_at": "@notnull"}, "messages_len": 1, "first_message": {"author_role": "system", "content": "@notnull", "created_at": "@notnull"}},
     {"op": "h_list", "user": "u1", "role": "user", "expect_len": 2, "expect_ids": ["t3", "t1"]}
   ]}, "expected": "ok"},

  {"name": "handoff-messages-roles-and-validation", "kind": "edge", "added": true,
   "input": {"action": "scenario", "audit": "none", "ops": [
     {"op": "h_open", "id": "ins-1", "user": "u1", "as": "t"},
     {"op": "h_post", "thread": "t", "author": "u1", "role": "user", "content": "please check", "as": "m1"},
     {"op": "h_post", "thread": "t", "author": "adm", "role": "human", "content": "looking", "as": "m2"},
     {"op": "h_post", "thread": "t", "author": "sys", "role": "system", "content": "note", "as": "m3"},
     {"op": "h_post", "thread": "t", "author": "u1", "role": "robot", "content": "x", "raises": "ValueError"},
     {"op": "h_post", "thread": "t", "author": "u1", "role": "user", "content": "", "raises": "ValueError"},
     {"op": "h_get", "thread": "t", "user": "u1", "role": "user", "expect": {}, "messages_len": 4, "last_message": {"author_id": "sys", "author_role": "system", "content": "note"}},
     {"op": "h_post", "thread": "nope", "author": "u1", "role": "user", "content": "hi", "raises": "HandoffNotFound"}
   ]}, "expected": "ok"},

  {"name": "handoff-access-control", "kind": "edge", "added": true,
   "input": {"action": "scenario", "audit": "none", "ops": [
     {"op": "h_open", "id": "ins-1", "user": "u1", "as": "t"},
     {"op": "h_get", "thread": "t", "user": "u2", "role": "user", "raises": "HandoffForbidden"},
     {"op": "h_get", "thread": "t", "user": "u2", "role": "analyst", "raises": "HandoffForbidden"},
     {"op": "h_get", "thread": "t", "user": "adm", "role": "admin", "expect": {"user_id": "u1"}},
     {"op": "h_get", "thread": "t", "user": "boss", "role": "super", "expect": {"user_id": "u1"}},
     {"op": "h_get", "thread": "nope", "user": "u1", "role": "user", "raises": "HandoffNotFound"},
     {"op": "h_list", "user": "u2", "role": "user", "expect_len": 0},
     {"op": "h_list", "user": "adm", "role": "admin", "expect_len": 1},
     {"op": "h_resolve", "thread": "t", "user": "u1", "role": "user", "raises": "HandoffForbidden"},
     {"op": "h_resolve", "thread": "t", "user": "u2", "role": "user", "raises": "HandoffForbidden"}
   ]}, "expected": "ok"},

